require 'json'
require 'fileutils'
ROOT = File.expand_path('..', __dir__)
CONFIG = JSON.parse(File.read(File.join(ROOT, 'release-config.json')))
BUNDLE_ID = CONFIG.fetch('bundleId')

def apple_api
  app_store_connect_api_key(key_id: ENV.fetch('ASC_KEY_ID'), issuer_id: ENV.fetch('ASC_ISSUER_ID'), key_content: ENV.fetch('ASC_KEY_P8_BASE64'), is_key_content_base64: true, duration: 1200)
end

def release_channel
  channel = ENV.fetch('RELEASE_CHANNEL')
  raise 'RELEASE_CHANNEL musi mieć wartość beta albo production.' unless ['beta', 'production'].include?(channel)
  channel
end

platform :ios do
  desc 'Sign and archive the iOS app. No store submission.'
  lane :package do
    keychain = 'pajaczek-ci'
    keypass = ENV.fetch('KEYCHAIN_PASSWORD')
    create_keychain(name: keychain, password: keypass, default_keychain: false, unlock: true, timeout: 3600, lock_when_sleeps: true)
    import_certificate(certificate_path: ENV.fetch('IOS_P12_PATH'), certificate_password: ENV.fetch('IOS_CERT_PASSWORD'), keychain_name: keychain, keychain_password: keypass)
    profile = FastlaneCore::ProvisioningProfile.parse(ENV.fetch('IOS_PROFILE_PATH'))
    install_provisioning_profile(path: ENV.fetch('IOS_PROFILE_PATH'))
    update_code_signing_settings(use_automatic_signing: false, path: File.join(ROOT, 'ios/App/App.xcodeproj'), team_id: ENV.fetch('APPLE_TEAM_ID'), targets: ['App'], code_sign_identity: 'Apple Distribution', profile_name: profile['Name'], bundle_identifier: BUNDLE_ID, build_configurations: ['Release'])
    build_app(project: File.join(ROOT, 'ios/App/App.xcodeproj'), scheme: 'App', configuration: 'Release', export_method: 'app-store', output_directory: File.join(ROOT, 'build/ios'), output_name: 'Pajaczek.ipa', export_options: { signingStyle: 'manual', teamID: ENV.fetch('APPLE_TEAM_ID'), provisioningProfiles: { BUNDLE_ID => profile['Name'] } })
  end

  desc 'Upload the already-built archive and optionally submit for review.'
  lane :publish do
    channel = release_channel
    api = apple_api
    ipa = File.join(ROOT, 'build/ios/Pajaczek.ipa')
    if channel == 'beta'
      upload_to_testflight(api_key: api, ipa: ipa, app_identifier: BUNDLE_ID, skip_waiting_for_build_processing: true, distribute_external: false)
    else
      contact = JSON.parse(ENV.fetch('REVIEW_CONTACT_JSON'))
      upload_to_app_store(api_key: api, ipa: ipa, app_identifier: BUNDLE_ID,
        app_version: ENV.fetch('APP_VERSION'), build_number: ENV.fetch('IOS_BUILD_NUMBER'),
        metadata_path: File.join(ROOT, 'store/ios/metadata'), screenshots_path: File.join(ROOT, 'store/ios/screenshots'),
        force: true, submit_for_review: true, automatic_release: true,
        precheck_include_in_app_purchases: false,
        copyright: CONFIG.fetch('copyright'),
        app_review_information: { first_name: contact['firstName'], last_name: contact['lastName'], phone_number: contact['phone'], email_address: contact['email'], demo_account_required: false },
        submission_information: { add_id_info_uses_idfa: false })
    end
  end
end

platform :android do
  desc 'Create a signed Android App Bundle. No store submission.'
  lane :package do
    gradle(task: 'bundle', build_type: 'Release', project_dir: File.join(ROOT, 'android'))
    FileUtils.mkdir_p(File.join(ROOT, 'build/android'))
    FileUtils.cp(File.join(ROOT, 'android/app/build/outputs/bundle/release/app-release.aab'), File.join(ROOT, 'build/android/Pajaczek.aab'))
  end
  desc 'Upload an already-built bundle to the selected Play track.'
  lane :publish do
    channel = release_channel
    upload_to_play_store(package_name: BUNDLE_ID, json_key: ENV.fetch('GOOGLE_PLAY_JSON_PATH'),
      aab: File.join(ROOT, 'build/android/Pajaczek.aab'),
      track: channel == 'beta' ? 'internal' : 'production', release_status: 'completed',
      metadata_path: File.join(ROOT, 'store/android/metadata'),
      skip_upload_metadata: channel == 'beta', skip_upload_images: channel == 'beta', skip_upload_screenshots: channel == 'beta',
      changes_not_sent_for_review: false)
  end
end
